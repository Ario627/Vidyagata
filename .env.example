# Wajib di produksi (Vercel/Railway)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
OTP_PEPPER=

# Postgres wajib di serverless (SQLite hanya untuk dev lokal).
# Supabase: pakai host POOLER — host db.<ref>.supabase.co hanya IPv6 dan
# gagal ENOTFOUND di Vercel. Ambil dari Connect -> Transaction pooler.
DATABASE_URL=

# Opsional
NEXT_PUBLIC_APP_URL=

# Data demo untuk pitching/demo publik.
# Di dev lokal aktif otomatis; di produksi (Railway/Vercel) wajib SEED_DEMO=true.
# Matikan kembali (SEED_DEMO=false) sebelum dipakai untuk data asli.
SEED_DEMO=
SEED_DEMO_PASSWORD=
